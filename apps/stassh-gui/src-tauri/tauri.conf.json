{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stassh",
  "version": "1.0.0",
  "identifier": "dev.stassh.gui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "./scripts/prepare-linux-bundle.sh",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "stassh",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": ["icons/icon.png"],
    "license": "MIT OR Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "linux": {
      "deb": {
        "files": {
          "/usr/bin/stassh": "binaries/stassh-x86_64-unknown-linux-gnu",
          "/usr/bin/stassh-tui": "binaries/stassh-tui-x86_64-unknown-linux-gnu"
        }
      },
      "rpm": {
        "release": "1",
        "files": {
          "/usr/bin/stassh": "binaries/stassh-x86_64-unknown-linux-gnu",
          "/usr/bin/stassh-tui": "binaries/stassh-tui-x86_64-unknown-linux-gnu"
        }
      }
    }
  }
}
